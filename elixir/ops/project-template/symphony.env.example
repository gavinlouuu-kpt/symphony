# Copy this file to symphony.env inside one project instance directory.
# Example instance root: /home/gavin/Service/symphony/biowork

# Required. Linear remains the default tracker.
LINEAR_API_KEY=
SYMPHONY_LINEAR_PROJECT_SLUG=
SYMPHONY_SOURCE_REPO_URL=

# Tracker settings. For GitHub Issues, use:
# SYMPHONY_TRACKER_KIND=github
# GITHUB_TOKEN=
# SYMPHONY_TRACKER_PROJECT=owner/repo
# SYMPHONY_TRACKER_ACTIVE_STATES='["open"]'
# SYMPHONY_TRACKER_TERMINAL_STATES='["closed"]'
SYMPHONY_TRACKER_KIND=linear
SYMPHONY_TRACKER_REQUIRED_LABELS=[]

# Instance identity and paths.
SYMPHONY_INSTANCE_ID=example-project
SYMPHONY_CODE_DIR=/home/gavin/Developer/symphony
SYMPHONY_INSTANCE_ROOT=/home/gavin/Service/symphony/example-project
SYMPHONY_RUNTIME_ROOT=/home/gavin/Service/symphony/example-project/runtime
SYMPHONY_LOGS_ROOT=/home/gavin/Service/symphony/example-project/log
SYMPHONY_EVIDENCE_ROOT=/home/gavin/Service/symphony/example-project/evidence
# CUA workspaces live inside each sandbox container, not on the host.
SYMPHONY_WORKSPACE_ROOT=/home/cua/workspaces

# Dashboard/API. Pick a unique port per project instance.
SYMPHONY_DASHBOARD_HOST=127.0.0.1
SYMPHONY_DASHBOARD_PORT=4401

# Workflow tuning.
SYMPHONY_POLL_INTERVAL_MS=30000
SYMPHONY_MAX_CONCURRENT_AGENTS=2
SYMPHONY_MAX_TURNS=20

# Optional OpenClaw channel bridge. Configure OpenClaw/Discord separately with
# `openclaw onboard` and `openclaw channels add --channel discord`.
SYMPHONY_OPENCLAW_ENABLED=false
SYMPHONY_OPENCLAW_COMMAND=openclaw
SYMPHONY_OPENCLAW_CHANNEL=discord
SYMPHONY_OPENCLAW_ACCOUNT=
# Discord target format is usually channel:<discord-channel-id>.
SYMPHONY_OPENCLAW_TARGET=
SYMPHONY_OPENCLAW_TIMEOUT_MS=10000
SYMPHONY_OPENCLAW_EVENTS='["dispatch_started", "role_agent_completed", "agent_completed", "issue_blocked", "retry_scheduled"]'

# Optional inbound OpenClaw profile: Discord/OpenClaw message -> GitHub issue
# -> Symphony GitHub tracker polling. Requires SYMPHONY_TRACKER_KIND=github.
SYMPHONY_OPENCLAW_INTAKE_ENABLED=false
SYMPHONY_OPENCLAW_INTAKE_TOKEN=
SYMPHONY_OPENCLAW_INTAKE_TOKEN_ENV=SYMPHONY_OPENCLAW_INTAKE_TOKEN
SYMPHONY_OPENCLAW_INTAKE_URL=http://127.0.0.1:4401/api/v1/openclaw/issues
SYMPHONY_OPENCLAW_INTAKE_LABELS='["symphony"]'

# Repo bootstrap in the CUA sandbox.
SYMPHONY_SOURCE_REPO_BRANCH=main
SYMPHONY_AFTER_CREATE_EXTRA=

# Mandatory per-repo sandbox requirements audit. Before enabling issue intake,
# review AGENTS.md, setup docs, CI workflows, package manifests, GUI/runtime docs,
# and test docs. Declare the minimum tools/dependencies every issue sandbox must
# have, then set SYMPHONY_SANDBOX_REQUIREMENTS_AUDITED=true.
SYMPHONY_SANDBOX_CONTRACT_ENFORCED=true
SYMPHONY_SANDBOX_REQUIREMENTS_AUDITED=false
SYMPHONY_SANDBOX_REQUIRED_COMMANDS=[]
SYMPHONY_SANDBOX_REQUIRED_PYTHON_MODULES=[]
SYMPHONY_SANDBOX_REQUIRED_SYSTEM_PACKAGES=[]
# Single-line command run after clone and SYMPHONY_AFTER_CREATE_EXTRA. It should
# fail when the sandbox cannot perform the repository's expected local validation.
SYMPHONY_SANDBOX_BOOTSTRAP_CHECK=
SYMPHONY_SANDBOX_REQUIREMENTS_NOTES=

# CUA sandbox settings. Pick a unique prefix per project.
# Set SYMPHONY_CUA_HOST to the same reachable host as the dashboard when
# operators need noVNC/API links to open from another machine.
SYMPHONY_CUA_HOST=127.0.0.1
SYMPHONY_CUA_IMAGE=symphony-cua-worker:latest
SYMPHONY_CUA_IMAGE_BUILD=auto
SYMPHONY_CUA_NAME_PREFIX=symphony-example-project
SYMPHONY_CUA_SSH_KEYGEN=auto
SYMPHONY_CUA_SSH_IDENTITY_FILE=/home/gavin/Service/symphony/example-project/ssh/id_ed25519
SYMPHONY_CUA_SSH_AUTHORIZED_KEY_PATH=/home/gavin/Service/symphony/example-project/ssh/id_ed25519.pub
SYMPHONY_CUA_DELETE_ON_TERMINAL=true
SYMPHONY_CUA_LAUNCH_TIMEOUT_MS=120000

# Codex runs on the host orchestrator, not inside CUA.
SYMPHONY_CODEX_COMMAND='codex --config shell_environment_policy.inherit=all --config model=\"gpt-5.5\" --config model_reasoning_effort=xhigh app-server'

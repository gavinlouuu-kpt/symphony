# Copy this file to symphony.env inside one project instance directory.
# Example instance root: /home/gavin/Service/symphony/biowork

# Required.
LINEAR_API_KEY=
SYMPHONY_LINEAR_PROJECT_SLUG=
SYMPHONY_SOURCE_REPO_URL=

# Instance identity and paths.
SYMPHONY_INSTANCE_ID=example-project
SYMPHONY_CODE_DIR=/home/gavin/Developer/symphony
SYMPHONY_INSTANCE_ROOT=/home/gavin/Service/symphony/example-project
SYMPHONY_RUNTIME_ROOT=/home/gavin/Service/symphony/example-project/runtime
SYMPHONY_LOGS_ROOT=/home/gavin/Service/symphony/example-project/log
SYMPHONY_EVIDENCE_ROOT=/home/gavin/Service/symphony/example-project/evidence
# CUA workspaces live inside each sandbox container, not on the host.
SYMPHONY_WORKSPACE_ROOT=/home/cua/workspaces

# Dashboard/API. Pick a unique port per project instance.
SYMPHONY_DASHBOARD_HOST=127.0.0.1
SYMPHONY_DASHBOARD_PORT=4401

# Optional Tailscale Serve stable URL.
# When enabled, bin/start.sh runs bin/tailserve.sh and exposes the dashboard at
# https://symphony-example-project.<tailnet>/
SYMPHONY_TAILSERVE_ENABLED=false
SYMPHONY_TAILSERVE_SERVICE=symphony-example-project
SYMPHONY_TAILSERVE_HTTPS_PORT=443
SYMPHONY_TAILSERVE_LOCAL_HOST=127.0.0.1

# Linear workflow tuning.
SYMPHONY_POLL_INTERVAL_MS=30000
SYMPHONY_MAX_CONCURRENT_AGENTS=2
SYMPHONY_MAX_TURNS=20

# Repo bootstrap in the CUA sandbox.
SYMPHONY_SOURCE_REPO_BRANCH=main
SYMPHONY_AFTER_CREATE_EXTRA=

# CUA sandbox settings. Pick a unique prefix per project.
# Set SYMPHONY_CUA_HOST to the same reachable host as the dashboard when
# operators need noVNC/API links to open from another machine.
SYMPHONY_CUA_HOST=127.0.0.1
SYMPHONY_CUA_IMAGE=symphony-cua-worker:latest
SYMPHONY_CUA_IMAGE_BUILD=auto
SYMPHONY_CUA_NAME_PREFIX=symphony-example-project
SYMPHONY_CUA_SSH_KEYGEN=auto
SYMPHONY_CUA_SSH_IDENTITY_FILE=/home/gavin/Service/symphony/example-project/ssh/id_ed25519
SYMPHONY_CUA_SSH_AUTHORIZED_KEY_PATH=/home/gavin/Service/symphony/example-project/ssh/id_ed25519.pub
SYMPHONY_CUA_DELETE_ON_TERMINAL=true
SYMPHONY_CUA_LAUNCH_TIMEOUT_MS=120000

# Codex runs on the host orchestrator, not inside CUA.
SYMPHONY_CODEX_COMMAND='codex --config shell_environment_policy.inherit=all --config model=\"gpt-5.5\" --config model_reasoning_effort=xhigh app-server'
